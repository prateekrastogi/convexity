# Binance USDT-M Futures — real values go in .env (gitignored). Separate keys per environment.
# NOTE: no live/paper rebalancer is built yet (see README.md, docs/EDGE.md §e) — nothing in this
# repo currently reads these vars. This file exists so the venue credential shape is ready when
# that work starts.
#
# PAPER (Futures): prefer DEMO; TESTNET is a legacy-but-working fallback (Nautilus 1.229 recommends DEMO for new Futures sims).
BINANCE_FUTURES_DEMO_API_KEY=
BINANCE_FUTURES_DEMO_API_SECRET=
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=
#
# LIVE — REAL MONEY. Only populate when going live, after a clean paper run.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
#
# Risk guardrails are NOT env vars — they're RED constants in code, versioned and reviewed like any
# other spec parameter: position sizing (fractional-Kelly, capacity ceiling) in
# src/convexity/leverage/config/defaults.py, the CUSUM kill-switch state machine in
# src/convexity/ops/brake/kill_switch.py + ops/config/defaults.py. There is no conf/live.yaml.
