# Daily equity-book position/equity check + journal marks (book-scoped, PAPER.md §11).
[Unit]
Description=convexity equity paper daily recon
Wants=network-online.target
After=network-online.target
OnFailure=convexity-alert@%n.service
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
EnvironmentFile=/home/speculation/convexity/.env
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/home/speculation/convexity/.venv/bin/python -m convexity.paper recon --live --book equity
TimeoutStartSec=600
