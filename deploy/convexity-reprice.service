# Mid-window maker RE-PEG for all three books (PAPER.md §12.7): cancel stale post-only orders
# and re-post the unfilled remainder at the CURRENT touch. Idempotent (remainder from our own
# journaled orderIds), so extra passes converge and never double-trade.
[Unit]
Description=convexity maker reprice pass
Wants=network-online.target
After=network-online.target
OnFailure=convexity-alert@%n.service
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
EnvironmentFile=/home/speculation/convexity/.env
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/home/speculation/convexity/.venv/bin/python -m convexity.paper reprice --live --book crypto
ExecStart=/home/speculation/convexity/.venv/bin/python -m convexity.paper reprice --live --book commodity
ExecStart=/home/speculation/convexity/.venv/bin/python -m convexity.paper reprice --live --book equity
TimeoutStartSec=1200
