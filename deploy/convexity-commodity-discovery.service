# Weekly commodity-perp discovery (PAPER.md §11.4): new venue commodity perps -> gitignored
# universe overlay + immediate kline/funding backfill + perp-only stitch. NEVER auto-trades;
# the RV book's PAIRS are frozen research config. Also reports crypto-universe drift FYI.
[Unit]
Description=convexity commodity perp discovery + backfill
Wants=network-online.target
After=network-online.target
OnFailure=convexity-alert@%n.service
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/home/speculation/convexity/.venv/bin/python scripts/discover_tradfi_perps.py
TimeoutStartSec=14400
