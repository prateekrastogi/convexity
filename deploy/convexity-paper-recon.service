# Daily reconciliation + equity mark (OPS.md sec 1 cadence): positions vs journaled targets,
# equity from the USDT+USDC balances (BTC excluded by mandate), journal marks for the TWR chain.
[Unit]
Description=convexity paper daily reconciliation
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
EnvironmentFile=/home/speculation/convexity/.env
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/home/speculation/convexity/.venv/bin/python -m convexity.paper recon --live
TimeoutStartSec=300
