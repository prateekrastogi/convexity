# convexity fleet schedule — the container's own scheduler (supercronic).
#
# Transcribed 1:1 from the 31 systemd timers this replaces. Container TZ=UTC and every original
# OnCalendar was UTC, so the fields are unchanged. Field order: m h dom mon dow (dow 0=Sun, 6=Sat).
#
# Every line goes through job.sh, which supplies the alerting and the one 15-minute retry that
# systemd's OnFailure= / retry@ units used to provide. Paths are written out in full rather than
# via a crontab variable — cron variable expansion depends on the shell and is not worth the
# fragility on a live trading path.
#
# BEHAVIOURAL DIFFERENCE vs systemd, deliberate and worth knowing: the old timers set
# Persistent=true, so a job missed while the host was down ran on next boot. cron has no
# catch-up — if the container is down at 00:25, that recon is skipped, not run late. The Sunday
# watchdog surfaces a missed weekly cycle; for a longer outage run the missed command by hand:
#   docker compose run --rm fleet -m convexity.paper <cmd>

SHELL=/bin/bash

# ---------------------------------------------------------------- daily recon (demo, then prod)
25 0 * * *  /app/deploy/docker/job.sh paper-recon python -m convexity.paper recon --live
30 0 * * *  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-paper-recon python -m convexity.paper recon --live
45 0 * * *  /app/deploy/docker/job.sh commodity-recon python -m convexity.paper recon --live --book commodity
50 0 * * *  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-commodity-recon python -m convexity.paper recon --live --book commodity
5 1 * * *   /app/deploy/docker/job.sh equity-recon python -m convexity.paper recon --live --book equity
10 1 * * *  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-equity-recon python -m convexity.paper recon --live --book equity

# ---------------------------------------------------------------- nightly state backup
# Passed the SYMLINKED path (-> /app), not /app: the script derives the remote branch name from
# basename, and /app would rename it to journal-backups-app and orphan the backup history.
10 6 * * *  /app/deploy/docker/job.sh backup bash /app/scripts/journal_backup.sh /home/speculation/convexity

# ---------------------------------------------------------------- Saturday cycle: rebalance
10 0 * * 6  /app/deploy/docker/job.sh paper-rebalance python -m convexity.paper rebalance --live
15 0 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-paper-rebalance python -m convexity.paper rebalance --live
40 0 * * 6  /app/deploy/docker/job.sh commodity-rebalance python -m convexity.paper rebalance --live --book commodity
45 0 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-commodity-rebalance python -m convexity.paper rebalance --live --book commodity
10 1 * * 6  /app/deploy/docker/job.sh equity-rebalance python -m convexity.paper rebalance --live --book equity
15 1 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-equity-rebalance python -m convexity.paper rebalance --live --book equity

# ---------------------------------------------------------------- flow-triggered catchup
20 1 * * 6  /app/deploy/docker/job.sh catchup python -m convexity.paper catchup --live --if-flow --book crypto
25 1 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-catchup python -m convexity.paper catchup --live --if-flow --book crypto

# ---------------------------------------------------------------- maker reprice passes (3 each)
30 1 * * 6  /app/deploy/docker/job.sh reprice python -m convexity.paper reprice --live --book crypto
10 2 * * 6  /app/deploy/docker/job.sh reprice python -m convexity.paper reprice --live --book crypto
50 2 * * 6  /app/deploy/docker/job.sh reprice python -m convexity.paper reprice --live --book crypto
35 1 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-reprice python -m convexity.paper reprice --live --book crypto
15 2 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-reprice python -m convexity.paper reprice --live --book crypto
55 2 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-reprice python -m convexity.paper reprice --live --book crypto

# ---------------------------------------------------------------- finalize (cross remainders)
20 2 * * 6  /app/deploy/docker/job.sh paper-finalize python -m convexity.paper finalize --live
25 2 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-paper-finalize python -m convexity.paper finalize --live
50 2 * * 6  /app/deploy/docker/job.sh commodity-finalize python -m convexity.paper finalize --live --book commodity
55 2 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-commodity-finalize python -m convexity.paper finalize --live --book commodity
20 3 * * 6  /app/deploy/docker/job.sh equity-finalize python -m convexity.paper finalize --live --book equity
25 3 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-equity-finalize python -m convexity.paper finalize --live --book equity

# ---------------------------------------------------------------- post-cycle execution audit
40 3 * * 6  /app/deploy/docker/job.sh tca python -m convexity.paper tca --live --book crypto
45 3 * * 6  CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-tca python -m convexity.paper tca --live --book crypto

# ---------------------------------------------------------------- weekly lake refresh
# One job, not four: the original ExecStart chained these with && so the stitch never runs on a
# failed backfill. Splitting them into separate cron lines would silently lose that ordering.
0 4 * * 6   /app/deploy/docker/job.sh lake-refresh bash -c 'python scripts/backfill_crypto_1m.py && python scripts/backfill_tradfi_perp_1m.py && python scripts/backfill_funding_1m.py && python scripts/stitch_tradfi_1m.py'

# ---------------------------------------------------------------- other data maintenance
30 5 * * 6  /app/deploy/docker/job.sh equity-datamaint python scripts/equity_data_maintenance.py
0 12 * * 5  /app/deploy/docker/job.sh commodity-discovery python scripts/discover_tradfi_perps.py

# ---------------------------------------------------------------- weekly watchdog + digest
0 12 * * 0  /app/deploy/docker/job.sh watchdog python scripts/fleet_watchdog.py
10 12 * * 0 CONVEXITY_VENUE=prod /app/deploy/docker/job.sh prod-watchdog python scripts/fleet_watchdog.py
30 12 * * 0 /app/deploy/docker/job.sh digest python scripts/fleet_digest.py
