# Window-end crossing of the commodity book's unfilled maker remainders (PAPER.md §4 fallback),
# scoped to the commodity journal's own orders.
[Unit]
Description=convexity commodity paper finalize (cross remainders)
Wants=network-online.target
After=network-online.target
OnFailure=convexity-alert@%n.service convexity-retry@%n.service
StartLimitIntervalSec=14400
StartLimitBurst=3
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
EnvironmentFile=/home/speculation/convexity/.env
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/home/speculation/convexity/.venv/bin/python -m convexity.paper finalize --live --book commodity
TimeoutStartSec=900
