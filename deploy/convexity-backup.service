# Nightly paper-state backup (PAPER.md §12.6): journals/ledgers are the accounting truth and
# exist nowhere else. Local rotation + off-VM git branch.
[Unit]
Description=convexity nightly paper-state backup
OnFailure=convexity-alert@%n.service
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
ExecStart=/bin/bash /home/speculation/convexity/scripts/journal_backup.sh
