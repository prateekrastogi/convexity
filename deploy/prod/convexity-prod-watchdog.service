# Weekly completeness watchdog (PAPER.md §12.6): every book must have live targets + a
# finalized record for the most recent Friday; a miss exits nonzero -> alert fires.
[Unit]
Description=convexity weekly fleet watchdog (PROD)
OnFailure=convexity-alert@%n.service
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/usr/bin/env CONVEXITY_VENUE=prod /home/speculation/convexity/.venv/bin/python scripts/fleet_watchdog.py
