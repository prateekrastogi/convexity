# Weekly paper rebalance session (PAPER.md §6): settles the prior week (TWR), computes the band-
# ensemble targets at the Friday close, sizes at quarter-Kelly over the USDT->USDC waterfall
# (BTC never), journals + submits maker-first orders. Oneshot by design: every session is a full
# pure-recompute (OPS restart doctrine) — there is no long-running daemon to corrupt.
[Unit]
Description=convexity paper weekly rebalance (PROD)
Wants=network-online.target
After=network-online.target
OnFailure=convexity-alert@%n.service convexity-retry@%n.service
StartLimitIntervalSec=14400
StartLimitBurst=3

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
EnvironmentFile=/home/speculation/convexity/.env
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/usr/bin/env CONVEXITY_VENUE=prod /home/speculation/convexity/.venv/bin/python -m convexity.paper rebalance --live
TimeoutStartSec=1800
