# Post-cycle execution audit (PAPER.md §12.7): shortfall vs model price, fill-weighted maker
# share, and coverage (held/target notional) — the decomposition of model-vs-venue drift.
[Unit]
Description=convexity post-cycle TCA (PROD)
Wants=network-online.target
After=network-online.target
OnFailure=convexity-alert@%n.service
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
EnvironmentFile=/home/speculation/convexity/.env
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/usr/bin/env CONVEXITY_VENUE=prod /home/speculation/convexity/.venv/bin/python -m convexity.paper tca --live --book crypto
ExecStart=/usr/bin/env CONVEXITY_VENUE=prod /home/speculation/convexity/.venv/bin/python -m convexity.paper tca --live --book commodity
ExecStart=/usr/bin/env CONVEXITY_VENUE=prod /home/speculation/convexity/.venv/bin/python -m convexity.paper tca --live --book equity
TimeoutStartSec=1800
