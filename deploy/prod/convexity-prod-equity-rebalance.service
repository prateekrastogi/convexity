# Weekly EQUITY-BOOK rebalance (PAPER.md §12): settles the prior week (book-scoped
# model equity on SCALED weights — the g_t carries L_half x breadth x brake), computes the
# D1-validated trend-ensemble targets (signal/equity_trend.py, parity-pinned), journals + submits
# maker-first orders under the account lock, then sweeps THIS BOOK'S orphans only. Staggered 30
# min after the commodity book (lock is the primary serialization; stagger is defense-in-depth).
[Unit]
Description=convexity equity paper weekly rebalance (trend ensemble) (PROD)
Wants=network-online.target
After=network-online.target
OnFailure=convexity-alert@%n.service convexity-retry@%n.service
StartLimitIntervalSec=14400
StartLimitBurst=3
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
EnvironmentFile=/home/speculation/convexity/.env
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/usr/bin/env CONVEXITY_VENUE=prod /home/speculation/convexity/.venv/bin/python -m convexity.paper rebalance --live --book equity
TimeoutStartSec=1800
