# Window-end crossing pass (PAPER.md §4): cancels resting maker orders and crosses any unfilled
# remainder as MARKET — tactic_for's final-slice fallback, 2h10m after the rebalance session.
[Unit]
Description=convexity paper finalize (cross unfilled remainders) (PROD)
Wants=network-online.target
After=network-online.target
OnFailure=convexity-alert@%n.service convexity-retry@%n.service
StartLimitIntervalSec=14400
StartLimitBurst=3
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/speculation/convexity
EnvironmentFile=/home/speculation/convexity/.env
Environment=PYTHONPATH=/home/speculation/convexity
ExecStart=/usr/bin/env CONVEXITY_VENUE=prod /home/speculation/convexity/.venv/bin/python -m convexity.paper finalize --live
TimeoutStartSec=600
